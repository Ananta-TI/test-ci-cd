# Salin file ini ke server/.env lalu sesuaikan nilainya.
# Opsi A: koneksi via DATABASE_URL (dipakai Render/Neon/Supabase)
# DATABASE_URL=postgresql://user:password@host:5432/cicd_auth

# Opsi B: koneksi per-parameter (untuk Postgres lokal / docker-compose)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=cicd_auth

JWT_SECRET=ganti-dengan-secret-yang-kuat
PORT=3000
